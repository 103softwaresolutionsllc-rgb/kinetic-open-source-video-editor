{
  "version": 2,
  "name": "kinetic-open-source-video-editor",
  "outputDirectory": "dist",
  "installCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "builds": [
    {
      "src": "dist/index.html",
      "use": "@vercel/static",
      "config": {
        "base": "/kinetic-open-source-video-editor/"
      }
    }
  ]
}
